SECRET_KEY=replace-this-with-a-random-secret-at-least-32-characters-long
ALGORITHM=HS256
DATABASE_URL=sqlite:///db.sqlite
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=.pepepe.p-e.kr
# The app applies this domain only when the request host is a matching pepepe.p-e.kr subdomain.
CORS_ORIGINS=https://www.pepepe.p-e.kr,http://www.pepepe.p-e.kr,http://localhost:5173,http://127.0.0.1:5173
# If the public frontend uses HTTPS, serve the API over HTTPS too and set COOKIE_SECURE=true.
KAKAO_REST_API_KEY=
# Required while Client Secret is enabled on the Kakao REST API key (enabled by default).
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://127.0.0.1:5173/login/kakao/callback
FRONTEND_URL=http://127.0.0.1:5173
PORTONE_STORE_ID=store-37c86276-1d61-4b0d-8dc4-140bd8e19578
PORTONE_CHANNEL_KEY=
# Keep the V2 API secret server-side only. Never add it to VITE_* variables.
PORTONE_API_SECRET=
