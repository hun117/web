# Example for the Windows Nginx installation used by this project.
# Copy the built ../static/* contents into C:/nginx-1.30.5/html before enabling it.
# API requests go directly from the browser to the URL configured in vite.config.js; this server does not proxy API routes.
server {
    listen 80;
    server_name _;

    root C:/nginx-1.30.5/html;
    index index.html;

    # Vite JS/CSS assets use /assets/ from the document root. API course image URLs still use /static/courses/.
    location ^~ /static/ {
        alias C:/nginx-1.30.5/html/;
    }

    # Vue history routes such as /posts and /course/1.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
